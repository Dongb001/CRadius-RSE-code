{
  "description": "Table 2: continuous radius encoding without CRC.",
  "model": "cradius_rse.models.ContinuousRadiusExtractionNetwork",
  "model_args": {
    "radius_encoding": "continuous",
    "max_radius_m": 4.0,
    "radius_encoder_hidden_dim": 64,
    "radius_encoder_activation": "gelu",
    "n_fft": 192,
    "hop_length": 128,
    "num_tf_blocks": 6,
    "feature_dim": 32,
    "lstm_hidden_dim": 64,
    "condition_dim": 4,
    "norm_window_frames": 250,
    "norm_eps": 1e-08
  },
  "training_args": {
    "loss": "cradius_rse.losses.RegionalExtractionLoss",
    "loss_args": {
      "zero_target_weight": 100,
      "eps": 1e-08,
      "zero_target_threshold": 1e-07,
      "max_loss": 40.0,
      "straight_through_clip": true
    },
    "optimizer": "torch.optim.Adam",
    "optimizer_args": {
      "lr": 0.0006
    },
    "scheduler": "torch.optim.lr_scheduler.ReduceLROnPlateau",
    "scheduler_args": {
      "mode": "min",
      "patience": 3,
      "factor": 0.5,
      "min_lr": 1e-06
    },
    "warmup_steps": 2000,
    "grad_clip": 1.0,
    "metrics": [
      "snr_i",
      "si_snr_i",
      "si_sdr_i"
    ],
    "init_checkpoint": "runs/discrete_init/checkpoints/best.pt",
    "init_checkpoint_skip_prefixes": [
      "radius_encoder."
    ],
    "monitor": "val/loss",
    "monitor_mode": "min",
    "data_parallel": true,
    "sample_rate": 16000,
    "logged_samples_per_count": 5
  },
  "train_dataset": "cradius_rse.data.RegionalMixtureDataset",
  "train_dataset_args": {
    "rir_root": "data/rirs/simulated",
    "speech_dir": "data/speech/train",
    "noise_dir": "data/noise/train",
    "base_mixtures_per_epoch": 21000,
    "duration": 4.5,
    "sample_rate": 16000,
    "query_radii": null,
    "query_sampling": "stratified_uniform",
